<div class="breadcrumb">
  <%= link_to "Projects", projects_path %>
  <span class="separator">/</span>
  <%= link_to @pipeline.project.name, @pipeline.project %>
  <span class="separator">/</span>
  <%= link_to "Pipeline ##{@pipeline.id}", [@pipeline.project, @pipeline] %>
  <span class="separator">/</span>
  <%= link_to "Jobs", project_pipeline_jobs_path(@pipeline.project, @pipeline) %>
  <span class="separator">/</span>
  <%= link_to "##{@job.id}", [@pipeline.project, @pipeline, @job] %>
  <span class="separator">/</span>
  <span>Edit</span>
</div>

<div class="form-layout">
  <h1><i class="fas fa-edit"></i> Edit Job</h1>
  <p style="margin-bottom: 24px; color: var(--text-secondary);">Update job #<%= @job.id %> details</p>

  <% if @job.errors.any? %>
    <div class="error-messages">
      <h2><%= pluralize(@job.errors.count, "error") %> prevented this job from being saved:</h2>
      <ul>
        <% @job.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: [@pipeline.project, @pipeline, @job], local: true) do |form| %>
    <div class="form-group">
      <%= form.label :name, "Job Name" %>
      <%= form.text_field :name, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :status, "Status" %>
      <%= form.select :status, Job.statuses.keys, {}, class: "form-control" %>
    </div>

    <div class="btn-group">
      <%= form.submit "Update Job", class: "btn btn-primary" %>
      <%= link_to "Cancel", [@pipeline.project, @pipeline, @job], class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>