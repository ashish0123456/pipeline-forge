<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "CI Platform" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="CI Platform">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= current_user ? "authenticated" : "guest" %>">
    <div class="app-container">
      <header class="app-header">
        <div class="header-brand">
          <%= link_to root_path, class: "brand-link", aria: { label: "CI Platform home" } do %>
            <span class="brand-mark" aria-hidden="true">CI</span>
            <span>CI Platform</span>
          <% end %>
        </div>
        <% if current_user %>
          <div class="header-actions">
            <span class="user-info"><span class="avatar"><%= current_user.email.first.upcase %></span><%= current_user.email %></span>
            <%= button_to logout_path, method: :delete, class: "text-button", aria: { label: "Sign out" } do %>
              <span aria-hidden="true">&#8599;</span> Sign out
            <% end %>
          </div>
        <% end %>
      </header>

      <div class="app-wrapper">
        <aside class="app-sidebar">
          <div class="sidebar-intro">
            <span class="eyebrow">Workspace</span>
            <strong>Delivery control</strong>
          </div>
          <nav class="sidebar-nav">
            <div class="nav-section">
              <h3 class="nav-title">Main</h3>
              <ul class="nav-list">
                <li>
                  <% nav_class = "nav-link #{current_page?(projects_path) ? 'active' : ''}" %>
                  <%= link_to projects_path, class: nav_class do %>
                    <span class="nav-icon" aria-hidden="true">&#9632;</span>
                    <span>Projects</span>
                  <% end %>
                </li>
              </ul>
            </div>
          </nav>
        </aside>

        <main class="app-main">
          <div class="content-container">
            <% if notice.present? %>
              <div class="alert alert-success" role="alert">
                <span aria-hidden="true">&#10003;</span>
                <%= notice %>
              </div>
            <% end %>

            <% if alert.present? %>
              <div class="alert alert-danger" role="alert">
                <span aria-hidden="true">!</span>
                <%= alert %>
              </div>
            <% end %>

            <%= yield %>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
