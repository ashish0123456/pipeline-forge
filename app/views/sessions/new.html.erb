<div class="auth-screen">
  <div class="auth-panel">
    <div class="brand-mark auth-mark">CI</div>
    <span class="eyebrow">Delivery control</span>
    <h1>Welcome back</h1>
    <p>Sign in to monitor pipelines, jobs, and release signals.</p>
    <%= form_with url: login_path, class: "auth-form" do |form| %>
      <div class="form-field">
        <%= form.label :email, "Email address" %>
        <%= form.email_field :email, required: true, autocomplete: "email", autofocus: true, placeholder: "you@company.com" %>
      </div>
      <div class="form-field">
        <%= form.label :password %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Your password" %>
      </div>
      <%= form.submit "Sign in", class: "btn btn-primary auth-submit" %>
    <% end %>
    <small class="auth-footnote">Access is managed by your workspace administrator.</small>
  </div>
</div>
