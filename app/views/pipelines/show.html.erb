<div class="breadcrumb">
  <%= link_to "Projects", projects_path %>
  <span class="separator">/</span>
  <%= link_to @project.name, @project %>
  <span class="separator">/</span>
  <%= link_to "Pipelines", project_pipelines_path(@project) %>
  <span class="separator">/</span>
  <span><%= @pipeline.name %></span>
</div>
<div class="detail-section detail-hero">
  <div class="page-header">
    <div class="page-header-title">
      <span class="eyebrow">Pipeline definition</span>
      <h1><%= @pipeline.name %></h1>
      <p>Part of <%= link_to @project.name, @project, class: "inline-link" %></p>
    </div>
    <div class="page-header-actions">
      <%= form_with url: run_project_pipeline_path(@project, @pipeline), method: :post, local: true, class: "pipeline-run-form" do |form| %>
        <%= form.label :commit_sha, "Commit SHA", class: "sr-only" %>
        <%= form.text_field :commit_sha, required: true, minlength: 40, maxlength: 40, pattern: "[0-9a-fA-F]{40}", placeholder: "40-character commit SHA", class: "form-control", aria: { label: "Commit SHA to run" } %>
        <%= form.submit "Run pipeline", class: "btn btn-primary", data: { turbo_confirm: "Run this pipeline at the selected commit?" } %>
      <% end %>
      <%= link_to "Edit", edit_project_pipeline_path(@project, @pipeline), class: "btn btn-secondary btn-sm" %>
      <%= button_to "Delete", [@project, @pipeline], method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger btn-sm" %>
    </div>
  </div>

  <div class="detail-row">
    <div class="detail-label">Status</div>
    <div class="detail-value">
      <span class="status-badge status-<%= @latest_run&.status || @pipeline.status %>">
        <span class="status-dot" aria-hidden="true"></span>
        <%= @latest_run&.status || "not run" %>
      </span>
    </div>
  </div>

  <div class="detail-row">
    <div class="detail-label">Created</div>
    <div class="detail-value"><%= @pipeline.created_at.strftime('%b %d, %Y at %I:%M %p') %></div>
  </div>

  <div class="detail-row">
    <div class="detail-label">Updated</div>
    <div class="detail-value"><%= @pipeline.updated_at.strftime('%b %d, %Y at %I:%M %p') %></div>
  </div>
</div>
<div class="section-heading section-heading-spaced"><div><span class="eyebrow">Definition</span><h2>Jobs</h2></div><%= link_to "Manage jobs", project_pipeline_jobs_path(@project, @pipeline), class: "text-link" %></div>
<div class="table-container table-shell">
  <% if @pipeline.jobs.any? %>
    <table class="table">
      <thead><tr><th>Job</th><th>Status</th><th>Position</th><th>Dependencies</th><th> </th></tr></thead>
      <tbody>
        <% @pipeline.jobs.ordered.each do |job| %>
          <tr>
            <td><%= link_to job.name, [@project, @pipeline, job], class: "table-primary" %><% if job.command.present? %><small class="table-subtext"><%= truncate(job.command, length: 56) %></small><% end %></td>
            <td><span class="status-badge status-<%= job.status %>"><span class="status-dot" aria-hidden="true"></span><%= job.status %></span></td>
            <td><span class="count-chip"><%= job.position + 1 %></span></td>
            <td><%= job.depends_on_ids.any? ? pluralize(job.depends_on_ids.size, "job") : "None" %></td>
            <td class="table-actions-cell"><%= link_to "Open", [@project, @pipeline, job], class: "table-action" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty-state"><div class="empty-icon">+</div><div class="empty-state-title">No jobs defined</div><p class="empty-state-text">Add the first step in this pipeline.</p><%= link_to "Add a job", new_project_pipeline_job_path(@project, @pipeline), class: "btn btn-primary" %></div>
  <% end %>
</div>

<div class="section-heading section-heading-spaced"><div><span class="eyebrow">Execution history</span><h2>Recent runs</h2></div><span class="section-count"><%= pluralize(@recent_runs.size, "run") %></span></div>
<div class="run-list">
  <% if @recent_runs.any? %>
    <% @recent_runs.each do |run| %>
      <div class="run-row"><div class="run-status"><span class="status-dot status-dot-<%= run.status %>"></span><strong><%= link_to "Run ##{run.id}", [@project, @pipeline, run] %></strong> <code><%= run.commit_sha %></code><% if run.failure_reason.present? %><small class="table-subtext"><%= run.failure_reason %></small><% end %></div><span class="status-badge status-<%= run.status %>"><%= run.status %></span><time datetime="<%= run.created_at.iso8601 %>"><%= time_ago_in_words(run.created_at) %> ago</time></div>
    <% end %>
  <% else %>
    <div class="empty-state compact"><div class="empty-icon">&#8599;</div><div class="empty-state-title">No runs yet</div><p class="empty-state-text">Run the pipeline to see progress and logs here.</p></div>
  <% end %>
</div>

