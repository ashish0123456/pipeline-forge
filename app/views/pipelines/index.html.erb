<div class="breadcrumb">
  <%= link_to "Projects", projects_path %>
  <span class="separator">/</span>
  <%= link_to @project.name, @project %>
  <span class="separator">/</span>
  <span>Pipelines</span>
</div>

<div class="page-header">
  <div class="page-header-title">
    <h1><i class="fas fa-stream"></i> Pipelines</h1>
    <p>All pipelines for <%= @project.name %></p>
  </div>
  <div class="page-header-actions">
    <%= link_to "+ New Pipeline", new_project_pipeline_path(@project), class: "btn btn-primary" %>
  </div>
</div>

<div class="table-container">
  <% if @pipelines.any? %>
    <table class="table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Status</th>
          <th>Created</th>
          <th>Jobs</th>
          <th style="width: 150px;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @pipelines.order(created_at: :desc).each do |pipeline| %>
          <tr>
            <td><strong><%= pipeline.name %></strong></td>
            <td>
              <span class="status-badge status-<%= pipeline.status %>">
                <i class="fas fa-circle" style="font-size: 8px;"></i>
                <%= pipeline.status %>
              </span>
            </td>
            <td><%= time_ago_in_words(pipeline.created_at) %> ago</td>
            <td>
              <span style="background-color: rgba(13, 71, 161, 0.05); padding: 4px 8px; border-radius: 4px; font-weight: 500;">
                <%= pipeline.jobs.count %>
              </span>
            </td>
            <td>
              <div class="action-links">
                <%= link_to "View", [@project, pipeline] %>
                <% if !pipeline.running? %>
                  <%= link_to "Run", run_project_pipeline_path(@project, pipeline), method: :post, data: { confirm: "Are you sure you want to run this pipeline?" }, style: "color: var(--success);" %>
                <% end %>
                <%= button_to "Delete", [@project, pipeline], method: :delete, data: { confirm: "Are you sure?" }, style: "color: var(--danger);" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty-state">
      <i class="fas fa-inbox"></i>
      <div class="empty-state-title">No pipelines yet</div>
      <p class="empty-state-text">Create a new pipeline to get started</p>
      <%= link_to "Create Pipeline", new_project_pipeline_path(@project), class: "btn btn-primary" %>
    </div>
  <% end %>
</div>