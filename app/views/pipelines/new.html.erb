<div class="breadcrumb">
  <%= link_to "Projects", projects_path %>
  <span class="separator">/</span>
  <%= link_to @project.name, @project %>
  <span class="separator">/</span>
  <%= link_to "Pipelines", project_pipelines_path(@project) %>
  <span class="separator">/</span>
  <span>New</span>
</div>

<div class="form-layout">
  <h1><i class="fas fa-play-circle"></i> Create New Pipeline</h1>
  <p style="margin-bottom: 24px; color: var(--text-secondary);">Start a new build for <%= @project.name %></p>

  <%= form_with(model: [@project, @pipeline], url: project_pipelines_path(@project), method: :post, local: true) do |form| %>
    <div class="form-group">
      <%= form.label :name, "Pipeline Name" %>
      <%= form.text_field :name, placeholder: "e.g., Build and Test", class: "form-control" %>
    </div>
    <div style="background-color: var(--light-bg); padding: 20px; border-radius: 8px; margin-bottom: 20px;">
      <p style="margin-bottom: 12px;">
        <i class="fas fa-info-circle" style: "color: var(--info); margin-right: 8px;"></i>
      This will create a new pipeline in pending state. You can run it manually after creation.
    </p>
    <p style="font-size: 13px; color: var(--text-secondary);">
      Pipelines are executed asynchronously using background jobs.
    </p>
    </div>
    <div class="btn-group">
      <%= form.submit "Create Pipeline", class: "btn btn-primary" %>
      <%= link_to "Cancel", project_pipelines_path(@project), class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>