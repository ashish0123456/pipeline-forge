<div class="page-header hero-header">
  <div class="page-header-title">
    <span class="eyebrow">Delivery workspace</span>
    <h1>Projects</h1>
    <p>Keep every pipeline, signal, and release in view.</p>
  </div>
  <div class="page-header-actions">
    <%= link_to new_project_path, class: "btn btn-primary" do %><span aria-hidden="true">+</span> New project<% end %>
  </div>
</div>

<div class="metric-grid">
  <div class="metric-card"><span class="metric-label">Projects</span><strong><%= @projects.size %></strong><span class="metric-note">in this workspace</span></div>
  <div class="metric-card"><span class="metric-label">Pipelines</span><strong><%= @projects.sum { |project| project.pipelines.size } %></strong><span class="metric-note">ready to run</span></div>
  <div class="metric-card metric-card-accent"><span class="metric-label">System</span><strong>Healthy</strong><span class="metric-note">database and workers online</span></div>
</div>

<div class="section-heading"><div><span class="eyebrow">Your projects</span><h2>Recent work</h2></div><span class="section-count"><%= pluralize(@projects.size, "project") %></span></div>
<div class="table-container table-shell">
  <% if @projects.any? %>
    <table class="table">
      <thead>
        <tr>
          <th>Project</th>
          <th>Repository</th>
          <th>Pipelines</th>
          <th> </th>
        </tr>
      </thead>
      <tbody>
        <% @projects.each do |project| %>
          <tr>
            <td>
              <strong class="table-primary"><%= link_to project.name, project %></strong>
            </td>
            <td>
              <code class="repo-url"><%= project.repository_url %></code>
            </td>
            <td>
              <span class="count-chip">
                <%= project.pipelines.count %>
              </span>
            </td>
            <td>
              <div class="action-links action-links-end">
                <%= link_to "Open project", project, class: "table-action" %>
                <%= link_to "Edit", edit_project_path(project), class: "table-action muted" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="table-empty">
      <div class="empty-state">
        <i class="fas fa-inbox"></i>
        <div class="empty-state-title">No projects yet</div>
        <p class="empty-state-text">Create your first project to get started</p>
        <%= link_to "Create Project", new_project_path, class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</div>