<div class="breadcrumb">
  <%= link_to "Projects", projects_path %>
  <span class="separator">/</span>
  <span>New Project</span>
</div>

<div class="form-layout">
  <h1><i class="fas fa-plus-circle"></i> Create New Project</h1>
  <p style="margin-bottom: 24px; color: var(--text-secondary);">Add a new project to your CI platform</p>

  <% if @project.errors.any? %>
    <div class="error-messages">
      <h2><%= pluralize(@project.errors.count, "error") %> prevented this project from being saved:</h2>
      <ul>
        <% @project.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: @project, local: true) do |form| %>
    <div class="form-group">
      <%= form.label :name, "Project Name" %>
      <%= form.text_field :name, placeholder: "e.g., My Awesome App", class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :repository_url, "Repository URL" %>
      <%= form.text_field :repository_url, placeholder: "https://github.com/user/repo", class: "form-control" %>
    </div>

    <div class="btn-group">
      <%= form.submit "Create Project", class: "btn btn-primary" %>
      <%= link_to "Cancel", projects_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>