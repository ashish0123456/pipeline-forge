<div class="breadcrumb">
  <%= link_to "Projects", projects_path %>
  <span class="separator">/</span>
  <span><%= @project.name %></span>
</div>

<div class="detail-section">
  <div class="page-header">
    <div class="page-header-title">
      <h1><i class="fas fa-cube"></i> <%= @project.name %></h1>
    </div>
    <div class="page-header-actions">
      <%= link_to "Edit", edit_project_path(@project), class: "btn btn-secondary btn-sm" %>
      <%= button_to "Delete", @project, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger btn-sm" %>
    </div>
  </div>

  <div class="detail-row">
    <div class="detail-label">Repository</div>
    <div class="detail-value">
      <code style="background-color: var(--light-bg); padding: 4px 8px; border-radius: 4px;"><%= @project.repository_url %></code>
    </div>
  </div>

  <div class="detail-row">
    <div class="detail-label">Created</div>
    <div class="detail-value"><%= @project.created_at.strftime('%b %d, %Y at %I:%M %p') %></div>
  </div>
</div>

<div class="page-header" style="margin-top: 32px;">
  <div class="page-header-title">
    <h2><i class="fas fa-stream"></i> Pipelines</h2>
    <p>View and manage pipelines for this project</p>
  </div>
  <div class="page-header-actions">
    <%= link_to "+ New Pipeline", new_project_pipeline_path(@project), class: "btn btn-primary" %>
  </div>
</div>

<div class="table-container">
  <% if @project.pipelines.any? %>
    <table class="table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Status</th>
          <th>Created</th>
          <th style="width: 150px;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @project.pipelines.order(created_at: :desc).each do |pipeline| %>
          <tr>
            <td><strong><%= pipeline.name %></strong></td>
            <td>
              <span class="status-badge status-<%= pipeline.status %>">
                <i class="fas fa-circle" style="font-size: 8px;"></i>
                <%= pipeline.status %>
              </span>
            </td>
            <td><%= time_ago_in_words(pipeline.created_at) %> ago</td>
            <td>
              <div class="action-links">
                <%= link_to "View", [@project, pipeline] %>
                <%= button_to "Delete", [@project, pipeline], method: :delete, data: { confirm: "Are you sure?" }, style: "color: var(--danger);" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty-state">
      <i class="fas fa-water"></i>
      <div class="empty-state-title">No pipelines yet</div>
      <p class="empty-state-text">Create a pipeline to start your first build</p>
      <%= link_to "Create Pipeline", new_project_pipeline_path(@project), class: "btn btn-primary" %>
    </div>
  <% end %>
</div>