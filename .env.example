RAILS_MASTER_KEY=replace-with-config-master-key
CI_PLATFORM_DATABASE_PASSWORD=replace-with-a-local-password
CI_SEED_ADMIN_EMAIL=admin@example.com
CI_SEED_ADMIN_PASSWORD=replace-with-a-strong-local-password

# Docker-backed pipeline execution (worker only)
CI_EXECUTOR_IMAGE=ruby:3.4.8-slim
CI_ARCHIVE_MAX_BYTES=52428800
CI_ARCHIVE_MAX_EXTRACTED_BYTES=209715200
CI_ARCHIVE_MAX_ENTRIES=20000
CI_EXECUTOR_WORKSPACE_BYTES=268435456
CI_EXECUTOR_TIMEOUT=300
CI_RUN_TIMEOUT=900
CI_EXECUTOR_MAX_OUTPUT_BYTES=200000
CI_EXECUTOR_MAX_LOG_BYTES_PER_JOB=1000000

# On Linux, set this to the numeric group ID that owns /var/run/docker.sock.
# Docker socket access is highly privileged. Only run trusted repositories.
DOCKER_GID=0